# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grader_etl
DB_USER=your_postgres_user_name
DB_PASSWORD=your_database_password

# API статистики
API_URL=api_url
API_CLIENT=client_name
API_CLIENT_KEY=your_api_client_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email: Яндекс SMTP с OAuth2
SMTP_HOST=smtp.yandex.com
SMTP_PORT=465
SMTP_USER=your_email@yandex.ru
SMTP_OAUTH_TOKEN=your_oauth_token
SMTP_FROM_EMAIL=your_email@yandex.ru
SMTP_TO_EMAIL=recipient@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true
